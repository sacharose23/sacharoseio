<script>
  document.addEventListener('DOMContentLoaded', function () {
    const testimonials = [
      {
        quote: "We give Captain's Hideaway 5 stars! It was the perfect place for our family, visiting from MI, MO, NC and PA, to stay during the holidays. The private, country home in a wooded setting is beautiful, and arriving in the dark to fresh snow and white lights made it even more spectacular. The home had EVERYTHING we needed to prep for the holidays and enjoy our time together. There was plenty of private space as well as enough room for everyone to gather together at the end of the day for a game of cards or relax in front of the tv and fireplace. It was super clean, a top priority for us, and very comfortable, even for our 87 year old mother! The hosts were thorough and provided clear directions for easy entry and use of amenities such as the fireplace, internet and television streaming services. We can't say enough about how pleased we were with everything about our stay at the Captain's Hideaway.",
        author: "Jean G and family",
        time: "Winter Stay 2024"
      },
      {
        quote: "The Captain's Hideaway was the perfect retreat for our family! The spacious yard was a safe haven for our kids to play without any traffic concerns. The setup is incredibly family-friendly, with rooms that allow little ones to nap peacefully behind closed doors and blackout curtains for restful sleep. Our kids loved the bunk room where they could hang out and have their own space. Plus, the ping pong table and games in the garage kept everyone entertained! Highly recommend for families looking for a relaxing and safe getaway.",
        author: "Matthew and Meghann W.",
        time: "Summer Stay 2024"
      }, {
        quote: "We thoroughly enjoyed our stay. The home is newly built with all new bedrooms, bathrooms and amenities. Perfect for large groups, yet allows space for privacy, smaller sitting areas and working. Spacious and comfortable living room with large television and sectional couch. Fully equipped kitchen to cook and entertain while staying at house. Numerous bedrooms with attached private bathrooms. Beds and linens were very comfortable. New washer and dryer. Large yard with spacious porch and plenty of privacy. We loved the location being only minutes from downtown Skaneateles and also close to other attractions. Host was very responsive. We will definitely stay here again and highly recommend it.",
        author: "Susan P.",
        time: "Summer Stay 2024"
      }, {
        quote: "Clean, spacious, wonderful beds, close to town…all of the standard things I look for in a rental; however, it was the little things that make it one of the best rentals I've stayed at. I love to cook and WOW, the kitchen had everything I could want, including two ovens!! I never even took the cookware I bring out of my car. The bedrooms are in separate areas of the house giving each the feel of a private wing. An upstairs game room with beds and tv let the kids hang out while the adults relaxed.  And no need to drag them to bed when they fell asleep!! And for me, the most important thing I look for in a rental…NO CLUTTER or personal effects!  I hate feeling like I'm staying in someone's home. And here, I felt like I was staying at a beautiful, luxurious lodge. Will definitely be back!!",
        author: "Alaine O.",
        time: "Winter Stay 2024"
      }
    ];

    let currentTestimonialIndex = 0;
    const testimonialElement = document.getElementById('testimonial');
    const authorElement = document.getElementById('author');
    const timeElement = document.getElementById('time');

    function showNextTestimonial() {
      currentTestimonialIndex = (currentTestimonialIndex + 1) % testimonials.length;
      updateTestimonial();
    }

    function showPrevTestimonial() {
      currentTestimonialIndex = (currentTestimonialIndex - 1 + testimonials.length) % testimonials.length;
      updateTestimonial();
    }

    function createIndicators() {
      const indicatorsContainer = document.getElementById('testimonial-indicators');
      indicatorsContainer.innerHTML = ''; // Clear existing indicators

      testimonials.forEach((_, index) => {
        const indicator = document.createElement('div');
        indicator.classList.add('w-2', 'h-2', 'rounded-full', 'cursor-pointer', 'bg-slate-400', 'hover:bg-slate-800');
        indicator.dataset.index = index;

        if (index === currentTestimonialIndex) {
          indicator.classList.add('bg-slate-800'); // Highlight the active indicator
        }

        indicator.addEventListener('click', () => {
          currentTestimonialIndex = index;
          updateTestimonial();
          createIndicators(); // Update the indicators
        });

        indicatorsContainer.appendChild(indicator);
      });
    }
    
    function updateTestimonial() {
      const currentTestimonial = testimonials[currentTestimonialIndex];
      testimonialElement.innerHTML = currentTestimonial.quote;
      authorElement.textContent = currentTestimonial.author;
      timeElement.textContent = currentTestimonial.time;

      createIndicators(); // Refresh indicators after updating the testimonial
    }

    // Initial update
    updateTestimonial();

    // Event listeners for manual navigation
    document
      .getElementById('prevBtn')
      .addEventListener('click', showPrevTestimonial);
    document
      .getElementById('nextBtn')
      .addEventListener('click', showNextTestimonial);
  });
</script>

<div class="grid grid-cols-8 text-center rounded-md text-blue"> 
  <button id="prevBtn" class="focus:outline-none" aria-label="Previous Testimonial">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-12 h-12 rounded-full p-2 hover:bg-opacity-60">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
  </button>
  <div class="col-span-6 relative p-2 ">
    <div id="testimonial" class="inline text-lg italic ">"</div>
    <!-- Thick Divider -->
    <div class="h-1 w-16 bg-primary rounded mx-auto my-8"></div>
    <div id="author" class="text-lg font-medium"></div>
    <div id="time" class="italic font-medium text-md"></div>
  </div>
  <button id="nextBtn" class="focus:outline-none ml-auto" aria-label="Next Testimonial">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-12 h-12 rounded-full p-2 hover:bg-opacity-60">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
</div>
<div id="testimonial-indicators" class="flex justify-center mt-4 space-x-2"></div>
