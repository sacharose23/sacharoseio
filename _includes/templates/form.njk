<form class="grid grid-cols-1 gap-6" onsubmit="handleSubmit(event)">

  <label class="block text-left">
    <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-900">
      Email address
    </span>

    <input
      required
      type="email"
      name="email"
      placeholder="you@example.com"
      class="mt-2 w-full border-4 border-neutral-900 bg-white px-3 py-3 text-neutral-900
             focus:outline-none focus:border-blue"
    />
  </label>

  <button
    aria-label="Join Newsletter"
    class="w-fit border-4 border-neutral-900 bg-green px-6 py-3
           font-mono text-sm uppercase tracking-wider text-white
           hover:bg-pink focus:outline-none"
  >
    Join the newsletter
  </button>

</form>


<!-- Loading Popup -->
<div id="loadingPopup" class="fixed inset-0 bg-storm-500 bg-opacity-50 hidden flex justify-center items-center">
  <div class="p-6 max-w-sm w-full rounded-lg border shadow-md sm:p-8 bg-white border-storm-700">
    <div class="flex justify-center items-center space-x-3">
      <svg class="animate-spin h-5 w-5 text-storm-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <h3 class="text-lg font-medium text-storm-700">Joining…</h3>
    </div>
  </div>
</div>

<script>
  function handleSubmit(event) {
    event.preventDefault();

    const form = event.target;
    if (!form.checkValidity()) {
      alert('Please enter a valid email address.');
      return;
    }

    const loadingPopup = document.getElementById('loadingPopup');
    loadingPopup.classList.remove('hidden');

    fetch('/api/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: form.email.value
      })
    })
    .then(response => {
      if (response.ok) {
        window.location.href = '/thank-you';
      } else {
        throw new Error('Newsletter signup failed.');
      }
    })
    .catch(error => {
      console.error(error);
      alert('Something went wrong. Please try again later.');
      loadingPopup.classList.add('hidden');
    });
  }
</script>
