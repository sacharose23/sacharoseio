<form class="grid grid-cols-1 gap-6" onsubmit="handleSubmit(event)">
  <label class="block text-left">
    <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-900">
      Email address
    </span>

    <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden">

    <input
      required
      type="email"
      name="email"
      placeholder="you@example.com"
      class="mt-2 w-full border-4 border-neutral-900 bg-white px-3 py-3 text-neutral-900
             focus:outline-none focus:border-blue"
    />
  </label>

  <!-- Turnstile widget -->
  <div
    class="cf-turnstile"
    data-sitekey="0x4AAAAAACNuntD6DBBR_ZA0"
    data-callback="onTurnstileSuccess">
  </div>

  <button
    aria-label="Join Newsletter"
    class="w-fit border-4 border-neutral-900 bg-green px-6 py-3
           font-mono text-sm uppercase tracking-wider text-white
           hover:bg-pink focus:outline-none"
  >
    Join the newsletter
  </button>
</form>

<!-- Loading Popup (Brutalist) -->
<div id="loadingPopup" class="fixed inset-0 hidden items-center justify-center bg-white/90">
  <div class="w-full max-w-sm border-4 border-neutral-900 bg-white p-6 shadow-[8px_8px_0_0_rgba(0,0,0,1)]">
    <div class="flex items-center gap-4">
      <span class="inline-block h-4 w-4 bg-blue border-2 border-neutral-900"></span>
      <span class="font-mono text-xs uppercase tracking-[0.25em] text-neutral-900">Joining…</span>
    </div>

    <div class="mt-4 h-2 w-full border-2 border-neutral-900 bg-white">
      <div class="h-full w-2/3 bg-green"></div>
    </div>

    <p class="mt-4 text-sm text-neutral-900">
      One moment.
    </p>
  </div>
</div>

<script>
  let turnstileToken=null;
  function onTurnstileSuccess(token){turnstileToken=token;}

  async function handleSubmit(event){
    event.preventDefault();
    const form=event.target;

    if(!form.checkValidity()){alert("Please enter a valid email address.");return;}
    if(!turnstileToken){alert("Verification didn’t load—refresh and try again.");return;}

    const loadingPopup=document.getElementById("loadingPopup");
    loadingPopup.classList.remove("hidden");
    loadingPopup.classList.add("flex");

    try{
      const res=await fetch("/api/newsletter",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          email:form.email.value,
          page:location.pathname,
          turnstileToken,
          company:form.company?form.company.value:""
        })
      });

      let payload=null;
      try{payload=await res.json();}catch(_){}

      if(res.status===201||res.status===202){window.location.href="/thank-you";return;}
      throw new Error(`Newsletter signup failed (${res.status}) ${payload?JSON.stringify(payload):""}`);
    }catch(error){
      console.error(error);
      alert("Something went wrong. Please try again later.");
      loadingPopup.classList.add("hidden");
      loadingPopup.classList.remove("flex");
    }finally{
      try{if(window.turnstile)window.turnstile.reset();}catch(_){}
      turnstileToken=null;
    }
  }
</script>
