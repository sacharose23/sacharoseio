<!doctype html>

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href={{ site.url + url }}/>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg"> 
    <link rel="icon" type="image/png" href="/img/favicon-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  </head>


  <body class="bg-storm-900 text-white font-display selection:bg-aurora/30">

    <!-- Mobile Menu -->
    <div id="menu" class="hidden fixed z-40 top-16 right-0 w-full sm:w-1/2 md:w-1/3 text-slate-900 bg-slate-50 flex flex-col py-8 text-3xl text-left shadow-lg">
      <button id="closeMenu" class="absolute top-4 right-4 text-4xl focus:outline-none">
        &times;
      </button>
      <div class="relative flex flex-col space-y-4 text-lg px-6">
        <a href="/" class="hover:underline hover:decoration-2 hover:underline-offset-2 hover:decoration-primary">Home</a>
        <a href="/#work" class="hover:underline hover:decoration-2 hover:underline-offset-2 hover:decoration-primary">Work</a>
        <a href="/#values" class="hover:underline hover:decoration-2 hover:underline-offset-2 hover:decoration-primary">Values</a>
        <a href="/#impact" class="hover:underline hover:decoration-2 hover:underline-offset-2 hover:decoration-primary">Impact</a>
        <a href="/#about" class="hover:underline hover:decoration-2 hover:underline-offset-2 hover:decoration-primary">About</a>
        <hr class="w-3/4 justify-center border-t-2 border-primary">
        <a rel="noopener noreferrer" href="#contact" class="uppercase text-sm text-slate-800 flex group hover:underline hover:decoration-2 hover:underline-offset-2 hover:decoration-primary">
          Start a Project
          <svg class="ml-2 w-5 h-5 transition-transform duration-300 group-hover:translate-x-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <header class="fixed top-0 inset-x-0 z-50 backdrop-blur-sm bg-storm-900/30">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center gap-2 font-mono text-sm tracking-wide uppercase text-lightning">
            <img src="/img/favicon.svg" alt="Storm Cloud icon" class="h-6 w-6">
            Storm Cloud
          </a>


          <!-- Mobile Screen -->
          <div class="block lg:hidden">
            <button id="menuBtn" class="focus:outline-none">
              <svg class="h-8 w-8 fill-current font-bold" viewBox="0 0 24 24">
                <path d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z"></path>
              </svg>
            </button>
          </div>

          <!-- Desktop nav -->
          <nav class="hidden md:flex items-center gap-6 text-sm text-white/80">
            <a href="/#work" class="hover:text-white">Work</a>
            <a href="/#values" class="hover:text-white">Values</a>
            <a href="/#impact" class="hover:text-white">Impact</a>
            <a href="/#about" class="hover:text-white">About</a>
            <a href="/#contact" class="ml-2 inline-flex items-center gap-2 rounded-full border border-white/20 px-3 py-1.5 hover:border-white/40">
              Start a Project
            </a>
          </nav>

        </div>
      </div>

 
    </header>

    {{ content | safe }}

    {% include "templates/footer.njk" %}

  <!-- JavaScript -->
<script>
  function closeMenu() {
    var menu = document.getElementById('menu');
    var menuBtn = document.getElementById('menuBtn');
    menu
      .classList
      .remove('fade-in');
    menu
      .classList
      .add('fade-out');
    setTimeout(function () {
      menu
        .classList
        .add("hidden");
    }, 500);
    menuBtn.style.display = "block";
  }

  document
    .getElementById('menuBtn')
    .addEventListener('click', function () {
      var menu = document.getElementById('menu');
      var menuBtn = document.getElementById('menuBtn');
      menu
        .classList
        .remove('hidden', 'fade-out');
      menu
        .classList
        .add('fade-in');
      menuBtn.style.display = "none";
    });
  
  document
    .getElementById('closeMenu')
    .addEventListener('click', closeMenu);

  // Close menu when any link inside the menu is clicked
  document.querySelectorAll('#menu a').forEach(function(link) {
    link.addEventListener('click', closeMenu);
  });
  </script>
  <!-- /JavaScript -->

  </body>
</html>