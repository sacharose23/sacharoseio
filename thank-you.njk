            </li>
            <li>
              <span class="inline-block w-3 h-3 bg-green border-2 border-neutral-900 mr-3"></span>
              No promotions
            </li>
            <li>
              <span class="inline-block w-3 h-3 bg-pink border-2 border-neutral-900 mr-3"></span>
              Easy unsubscribe
            </li>
          </ul>
        </div>
      </aside>
    </div>

    <div class="mt-12 border-t-4 border-neutral-900 pt-8">
      <a
        href="/"
        class="inline-block border-4 border-neutral-900 bg-white px-6 py-3
               font-mono text-sm uppercase tracking-wider
               hover:bg-blue hover:text-white transition-colors"
