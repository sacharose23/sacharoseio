<section class="min-h-screen bg-white text-neutral-900 flex items-center justify-center selection:bg-pink/30 selection:text-neutral-900">
  <div class="mx-auto max-w-2xl px-6 py-16">

    <div class="border-b-4 border-neutral-900 pb-6 mb-10">
      <p class="font-mono text-sm uppercase tracking-[0.25em]">
        Confirmation
      </p>

      <h1 class="mt-4 text-4xl md:text-5xl font-semibold tracking-tight leading-tight">
